# Godot 4
.godot/
*.zip
*.pck
*.export_template
# Local developer MCP bridge. The editor plugin still loads this path when
# the file exists; ignoring it is what stops `git add -A` from shipping it.
mcp_bridge.gd
/mcp_bridge.gd.uid

# Original game rips — dev reference only, do not ship
assets/reference/

# Android build artifacts
android/build/
android/.build_version
exports/

# Export credentials and signing
.godot/export_credentials.cfg
*.apk
*.aab
*.keystore

# OS
.DS_Store
Thumbs.db
*.log
.mcp/
.idea/
.vscode/

# Local scratch dumps, one-off scripts, audit leftovers
.tmp/
/tmp_*.png
/tmp_*.txt
/_head_world.png
/_head_world.png.import
tools/saboteur_rip/_*.py

# Local Godot editor drop (binaries; .cursor/mcp.json points here)
tools/godot/

# Godot sidecars for ripped world objects and audit shots.
# Tileset/sprite .import files that matter are already tracked.
assets/world/objects/**/*.import
assets/world/s2_object_world.png.import
assets/world/s2_object_world_overview.png.import
docs/audit_views/**/*.import

# Python bytecode (was committed under tools/saboteur_rip/__pycache__/)
__pycache__/
*.py[cod]

# Machine-local MCP servers (absolute editor/tool paths). Copy
# .cursor/mcp.json.example to .cursor/mcp.json and replace the C:\Path\To\...
# placeholders with your Godot executable, this repo's
# tools/aseprite-mcp/build/index.js, and aseprite.exe. The example uses
# cmd /c for Windows.
.cursor/mcp.json
